  year        = {2026},
  arxiv_year  = {2025},
  arxiv       = {2507.15130},
  pdf         = {https://arxiv.org/pdf/2507.15130},
  abstract    = {We introduce VideoPlan, a multimodal large language model optimized for long-horizon visual planning. We propose Auxiliary Task Augmentation and Multi-token Prediction to enhance its visual planning ability. VideoPlan achieves SOTA performance on COIN and CrossTask for the challenging Visual Planning for Assistance (VPA) task. VideoPlan also achieves competitive performance on the Ego4D Long-term Action Anticipation benchmark.},
  preview     = {videoplan.png},
  bibtex_show = {true},
  selected    = {true}
}

@inproceedings{pan2025basket,
  abbr        = {CVPR},
  title       = {BASKET: A Large-Scale Video Dataset for Fine-Grained Skill Estimation},
  author      = {Pan, Yulu and Zhang, Ce and Bertasius, Gedas},
  booktitle   = {IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)},
